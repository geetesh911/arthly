{
  "name": "arthly",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p functions",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build": "pnpm --filter @pv/web build",
    "e2e": "pnpm --filter @pv/web e2e",
    "hash": "node scripts/hash-build.mjs apps/web/build",
    "relay": "wrangler pages dev --port 8788",
    "deploy": "pnpm build && wrangler pages deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
